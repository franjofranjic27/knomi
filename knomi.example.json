{
  "default_profile": "local",
  "profiles": {
    "local": {
      "store": {
        "backend": "chroma",
        "path": "./.knomi/chroma",
        "collection": "knomi"
      },
      "embedding": {
        "backend": "local",
        "model": "sentence-transformers/all-MiniLM-L6-v2",
        "dim": 384
      },
      "chunking": {
        "strategy": "structure",
        "chunk_size": 512,
        "chunk_overlap": 64
      }
    },
    "cloud": {
      "store": {
        "backend": "qdrant",
        "url": "https://your-cluster.qdrant.io:6333",
        "collection": "knomi"
      },
      "embedding": {
        "backend": "openai",
        "model": "text-embedding-3-small",
        "dim": 1536,
        "workers": 4
      },
      "chunking": {
        "strategy": "token",
        "chunk_size": 512,
        "chunk_overlap": 64
      }
    },
    "cloud-aws": {
      "store": {
        "backend": "pgvector",
        "collection": "knomi"
      },
      "embedding": {
        "backend": "cohere",
        "model": "embed-english-v3.0",
        "dim": 1024,
        "workers": 4
      },
      "chunking": {
        "strategy": "sentence",
        "chunk_size": 512,
        "chunk_overlap": 64
      }
    }
  }
}
